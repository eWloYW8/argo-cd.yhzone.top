    {
      "id": 8,
      "title": "Disk writes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(node) (rate(node_disk_written_bytes_total{job=\"node-exporter\",device!~\"loop.*|ram.*\"}[5m]))",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
